#!/bin/bash
cd "$(dirname "$0")"

echo "================================================================"
echo "      🚀 رفع موقع حسن سرحان إلى GitHub (hsn96srhan/hsn)"
echo "================================================================"
echo ""
echo "المستودع الهدف: https://github.com/hsn96srhan/hsn.git"
echo "الفرع: main"
echo ""

git remote set-url origin https://github.com/hsn96srhan/hsn.git
git branch -M main

echo "جاري الرفع الآن إلى GitHub..."
echo "إذا طلب اسم المستخدم (Username): اكتب hsn96srhan"
echo "إذا طلب كلمة المرور (Password): الصق رمز الـ Token (ghp_...)"
echo "----------------------------------------------------------------"

git push -u origin main

if [ $? -eq 0 ]; then
    echo ""
    echo "================================================================"
    echo "  ✅ تم رفع كامل الملفات والبيانات بنجاح إلى GitHub!"
    echo "================================================================"
else
    echo ""
    echo "================================================================"
    echo "  ⚠️ حدث خطأ أثناء الرفع (غالباً بسبب كلمة المرور/الرمز)."
    echo "================================================================"
fi

echo ""
read -p "اضغط Enter لإغلاق هذه النافذة..."
